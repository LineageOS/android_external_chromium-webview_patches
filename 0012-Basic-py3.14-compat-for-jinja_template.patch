From: "Kevin F. Haggerty" <haggertk@lineageos.org>
Date: Sat, 6 Jun 2026 10:22:21 -0600
Subject: [PATCH 12/13] Basic py3.14 compat for jinja_template

---
 build/android/gyp/jinja_template.py | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/build/android/gyp/jinja_template.py b/build/android/gyp/jinja_template.py
index 2b717db4241c2..f4a14a64a1b0a 100755
--- a/build/android/gyp/jinja_template.py
+++ b/build/android/gyp/jinja_template.py
@@ -6,7 +6,6 @@
 
 """Renders one or more template files using the Jinja template engine."""
 
-import codecs
 import argparse
 import os
 import sys
@@ -69,11 +68,11 @@ def _ProcessFile(processor, input_filename, output_filename):
     # If |output| is same with the file content, we skip update and
     # ninja's restat will avoid rebuilding things that depend on it.
     if os.path.isfile(output_filename):
-        with codecs.open(output_filename, 'r', 'utf-8') as f:
+        with open(output_filename, 'r', encoding='utf-8') as f:
             if f.read() == output:
                 return
 
-    with codecs.open(output_filename, 'w', 'utf-8') as output_file:
+    with open(output_filename, 'w', encoding='utf-8') as output_file:
         output_file.write(output)
 
 
@@ -120,7 +119,7 @@ def main():
     parser.add_argument(
         '--includes',
         default='',
-        help="GN-list of files that get {% include %}'ed.",
+        help="GN-list of files that get {%% include %%}'ed."
     )
     parser.add_argument(
         '--output',
